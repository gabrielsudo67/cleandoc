# MODELO de credenciais — copie para "secrets.toml" e preencha.
# O arquivo real (secrets.toml) NÃO vai para o GitHub (está no .gitignore).
# Na Streamlit Cloud, cole estes valores em: App > Settings > Secrets.

[mercadopago]
access_token = "SEU_ACCESS_TOKEN_DO_MERCADO_PAGO"

[supabase]
url = "https://SEU_PROJETO.supabase.co"
key = "SUA_SECRET_KEY_DO_SUPABASE"

[app]
base_url = "http://localhost:8501"   # em produção: https://SEU-APP.streamlit.app
